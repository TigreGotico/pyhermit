<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
          ontologyIRI="http://protege.stanford.edu/plugins/owl/owl-library/koala.owl">
  <Declaration><Class IRI="#Koala"/></Declaration>
  <Declaration><Class IRI="#Marsupial"/></Declaration>
  <Declaration><Class IRI="#KoalaWithPhD"/></Declaration>
  <Declaration><Class IRI="#Forest"/></Declaration>
  <Declaration><ObjectProperty IRI="#hasHabitat"/></Declaration>
  <SubClassOf>
    <Class IRI="#Koala"/>
    <Class IRI="#Marsupial"/>
  </SubClassOf>
  <SubClassOf>
    <Class IRI="#KoalaWithPhD"/>
    <Class IRI="#Koala"/>
  </SubClassOf>
  <SubClassOf>
    <Class IRI="#Koala"/>
    <ObjectSomeValuesFrom>
      <ObjectProperty IRI="#hasHabitat"/>
      <Class IRI="#Forest"/>
    </ObjectSomeValuesFrom>
  </SubClassOf>
  <DisjointClasses>
    <Class IRI="#Koala"/>
    <Class IRI="#Forest"/>
  </DisjointClasses>
</Ontology>
